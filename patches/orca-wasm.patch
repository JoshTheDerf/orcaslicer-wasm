+// Matches the regex
+//   \s(VELOCITY|ACCEL|ACCEL_TO_DECEL|SQUARE_CORNER_VELOCITY|MINIMUM_CRUISE_RATIO)\s*=\s*
+//   ([+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?=\s|;|$)   (icase)
+// without std::regex, which costs milliseconds per line under WebAssembly and
+// dominated G-code export on Klipper printers. Appends (NAME, text of the number).
+static void scan_set_velocity_limit_params(const std::string& s, std::vector<std::pair<std::string, std::string>>& out)
+{
+    static const char* const names[] = { "VELOCITY", "ACCEL", "ACCEL_TO_DECEL", "SQUARE_CORNER_VELOCITY", "MINIMUM_CRUISE_RATIO" };
+    auto sp = [&s](size_t i) { return i < s.size() && std::isspace(static_cast<unsigned char>(s[i])); };
+    auto dg = [&s](size_t i) { return i < s.size() && std::isdigit(static_cast<unsigned char>(s[i])); };
+    for (size_t pos = 0; pos < s.size();) {
+        if (!sp(pos)) { ++pos; continue; }
+        size_t match_end = 0;
+        // The regex alternation is ordered, but only one name can be followed by \s*= here.
+        for (const char* name : names) {
+            const size_t n = std::strlen(name), b = pos + 1;
+            if (b + n > s.size() || strncasecmp(s.c_str() + b, name, n) != 0)
+                continue;
+            size_t i = b + n;
+            while (sp(i)) ++i;
+            if (i >= s.size() || s[i] != '=')
+                continue;
+            ++i;
+            while (sp(i)) ++i;
+            const size_t v = i;
+            if (i < s.size() && s[i] == '+') ++i;
+            if (dg(i)) {
+                while (dg(i)) ++i;
+                if (i < s.size() && s[i] == '.') { ++i; while (dg(i)) ++i; }
+            } else if (i < s.size() && s[i] == '.' && dg(i + 1)) {
+                ++i; while (dg(i)) ++i;
+            } else
+                continue;
+            if (i < s.size() && (s[i] == 'e' || s[i] == 'E')) {
+                size_t j = i + 1;
+                if (j < s.size() && (s[j] == '+' || s[j] == '-')) ++j;
+                if (dg(j)) { i = j; while (dg(i)) ++i; }
+            }
+            if (i < s.size() && !sp(i) && s[i] != ';')
+                continue;
+            out.emplace_back(name, s.substr(v, i - v));
+            match_end = i;
+            break;
+        }
+        pos = match_end ? match_end : pos + 1;
+    }
+}
