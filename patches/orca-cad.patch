+    // ---- CubbySlicer (cad.wasm bridge, patches/orca-cad.patch) ---------------------------------
+    // Observer of recompute()'s replay loop: progress, cancellation, the failing feature, and a
+    // cache of the running body list. Not owned, and not part of the document's value (a copy
+    // of the document copies the pointer: set it per instance). Every hook has a no-op default.
+    struct ReplayObserver {
+        virtual ~ReplayObserver() = default;
+        // After the parametric pass, before the first feature. May put features[0..k) and
+        // `built` back to the state a previous replay had right before features[k], and return
+        // k: the loop then starts there. 0 = replay everything.
+        virtual size_t begin(CadDocument& doc, std::vector<CadBody>& built) { (void)doc; (void)built; return 0; }
+        // Around replay_feature(fi). Returning false from before_feature cancels the rebuild
+        // (recompute() fails with "rebuild cancelled").
+        virtual bool before_feature(CadDocument& doc, size_t fi, const std::vector<CadBody>& built) { (void)doc; (void)fi; (void)built; return true; }
+        virtual void after_feature(CadDocument& doc, size_t fi, const std::vector<CadBody>& built) { (void)doc; (void)fi; (void)built; }
+        // Every feature replayed, before the finishing passes and tessellation; false = cancel.
+        virtual bool replayed(CadDocument& doc, const std::vector<CadBody>& built) { (void)doc; (void)built; return true; }
+        // recompute() is about to return `ok`.
+        virtual void finished(CadDocument& doc, bool ok) { (void)doc; (void)ok; }
+    };
+    ReplayObserver* replay_observer{nullptr};
+    // The feature the last recompute() failed on (its replay or its expression binding threw, or
+    // it destroyed its body), -1 when it succeeded or failed outside any one feature.
+    int failed_feature{-1};
+    // faces_made_by(index) from the body lists right before and right after features[index] in a
+    // replay of the current history (what faces_made_by(index) replays a scratch document for).
+    std::vector<std::pair<int, int>> faces_made_by(int index, const std::vector<CadBody>& before,
+                                                   const std::vector<CadBody>& after) const;
