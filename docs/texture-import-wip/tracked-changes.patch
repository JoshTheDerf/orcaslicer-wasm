+    layers: [{ slot: 0, depth_mm: 0.5, tiling_scale: 8, color_enabled: true }] });
+  const colorCfg = { filament_colour: ['#FF0000', '#0000FF', '#FFFFFF'] };
+  const pal = tool('texture_displacement_palette', (off) => ({ layers: layers(), images: { 0: { offset: off, length: flat.length } }, color: { config: colorCfg } }), [], flat);
+  ok(pal.ok && pal.result.anyColor && pal.result.layers[0].hasColor && pal.result.layers[0].flatColors && pal.result.filaments === 3 && pal.result.maxMixes === 29,
+     `palette: ${JSON.stringify(pal.result?.layers)} filaments ${pal.result?.filaments} maxMixes ${pal.result?.maxMixes} ${pal.error ?? ''}`);
+  const fl = tool('texture_displacement', (off) => ({ layers: layers(), images: { 0: { offset: off, length: flat.length } }, paint: { 0: all },
+    color: { config: colorCfg } }), [cube], flat);
+  const tc = fl.blobData?.triangleColor;
+  const tris = fl.meshData?.[0] ? fl.meshData[0].i.length / 3 : 0;
+  const used = tc ? [...new Set(tc)].filter((v) => v > 0).sort() : [];
+  ok(fl.ok && tc && tc.length === tris && used.join() === '1,2' && fl.result.colors.newMixedFilaments.length === 0,
+     `flat-colour bake: ${tris} tris, palette entries used ${used} (red, blue), no mixes ${fl.error ?? ''}`);
+  const cp = fl.result?.paint?.color ?? [];
+  const reopen = tool('paint_open', { paint: cp, maxState: 32 }, [fl.meshData?.[0] ?? cube]);
+  ok(fl.ok && cp.length > 0 && cp.length <= tris && reopen.ok && reopen.result.states.join() === '1,2',
+     `colour paint strings on the baked mesh (${cp.length} triangles, states ${reopen.result?.states}) — paint.color format`);
+  tool('paint_close', { handle: reopen.result?.handle }, []);
+  ok(fl.ok && fl.result.topologyChanged && fl.result.moved && fl.result.clearSlots.length === 8, `bake reports topology change + masks to clear (${fl.result?.clearSlots})`);
+  // A gradient (photo-like): purple between red and blue → a red/blue mix, reported as a new mixed slot.
+  const grad = pngRGB(64, 64, (x) => { const t = x / 63; return [Math.round(230 * (1 - t)), 20, Math.round(230 * t)]; });
+  const gr = tool('texture_displacement', (off) => ({ layers: layers(), images: { 0: { offset: off, length: grad.length } }, paint: { 0: all },
+    color: { config: colorCfg } }), [cube], grad);
+  const nm = gr.result?.colors?.newMixedFilaments ?? [];
+  const pl = gr.result?.colors?.palette ?? [];
+  ok(gr.ok && pl.length > 3 && nm.length > 0 && nm.every((m) => m.slot >= 3 && m.components.length === 2 && m.ratios[0] + m.ratios[1] === 100),
+     `gradient bake: palette ${pl.length} entries, new mixed slots ${JSON.stringify(nm.map((m) => [m.slot, m.components.join('+'), m.ratios.join(':')]))} ${gr.error ?? ''}`);
+  const mixState = Math.max(...(gr.blobData?.triangleColor ?? [0]));
+  ok(gr.ok && pl[mixState - 1]?.filament >= 3, `a mixed palette entry prints in its new slot (entry ${mixState} -> filament ${pl[mixState - 1]?.filament})`);
+  // An existing fixed mixed slot is reused instead of adding one; mixing off -> no mixes at all.
+  const reuse = nm[0] ? { filament_colour: ['#FF0000', '#0000FF', '#FFFFFF', '#800080'], filament_is_mixed: ['0', '0', '0', '1'],
+    filament_mixed_components: ['', '', '', nm[0].components.join(',')],
+    filament_mixed_sublayer_ratios: ['', '', '', nm[0].ratios.map((r) => (r / 100).toFixed(4)).join(',')] } : colorCfg;
+  const ru = tool('texture_displacement', (off) => ({ layers: layers({ color_mix_count: 1 }), images: { 0: { offset: off, length: grad.length } }, paint: { 0: all },
+    color: { config: reuse } }), [cube], grad);
+  ok(ru.ok && (ru.result.colors.newMixedFilaments.length === 0) && ru.result.colors.palette.some((e) => e.a !== e.b && e.filament === 3),
+     `existing mixed slot reused (${JSON.stringify(ru.result?.colors?.palette?.filter((e) => e.a !== e.b))}) ${ru.error ?? ''}`);
+  const off = tool('texture_displacement', (o) => ({ layers: layers({ color_mix_enabled: false }), images: { 0: { offset: o, length: grad.length } }, paint: { 0: all },
+    color: { config: colorCfg } }), [cube], grad);
+  ok(off.ok && off.result.colors.palette.length === 3 && off.result.colors.newMixedFilaments.length === 0, 'Mix filaments off: filaments only');
+  // The volume's own paint is carried onto the rebuilt mesh; a grey texture colours nothing.
+  const seam = tool('paint_from_states', { states: [[8, 1], [9, 1]] }, [cube]).result.paint;
+  const grey = png(64, 64, (x, y) => ((x >> 3) + (y >> 3)) % 2 ? 255 : 0);
+  const gy = tool('texture_displacement', (o) => ({ layers: layers(), images: { 0: { offset: o, length: grey.length } }, paint: { 0: all.slice(0, 4) },
+    volumePaint: { seam }, color: { config: colorCfg } }), [cube], grey);
+  ok(gy.ok && !gy.result.colors && gy.result.paint?.seam?.length > 0, `grey texture: no colour output; seam paint carried (${gy.result?.paint?.seam?.length} triangles) ${gy.error ?? ''}`);
+  // The model's UV channel goes in and comes back resampled onto the baked triangles.
+  const uv = new Float32Array(12 * 6).map((_, k) => (k % 6) / 6);
+  const uvb = new Uint8Array(uv.buffer);
+  const mu = tool('texture_displacement', (o) => ({ layers: { version: 1, options: {}, layers: [{ slot: 0, depth_mm: 0.5, tiling_scale: 8 }] },
+    images: { 0: { offset: o, length: grey.length } }, paint: { 0: all }, modelUv: { offset: o + grey.length + ((4 - grey.length % 4) % 4), length: uvb.length } }),
+    [cube], (() => { const pad = (4 - grey.length % 4) % 4; const b = new Uint8Array(grey.length + pad + uvb.length); b.set(grey); b.set(uvb, grey.length + pad); return b; })());
+  ok(mu.ok && mu.blobData?.modelUv?.length === (mu.meshData[0].i.length / 3) * 24, `modelUv resampled onto ${mu.meshData?.[0]?.i.length / 3} triangles ${mu.error ?? ''}`);
+}
